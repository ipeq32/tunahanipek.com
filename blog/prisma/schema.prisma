generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp")]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Permission {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key             String           @unique
  groupKey        String
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@index([groupKey, sortOrder])
}

model AccessRole {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  slug            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  users           User[]
  rolePermissions RolePermission[]

  @@index([isSystem])
}

model RolePermission {
  accessRoleId String     @db.Uuid
  permissionId String     @db.Uuid
  accessRole   AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([accessRoleId, permissionId])
  @@index([permissionId])
}

model Language {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String   @unique
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  blogTranslations    BlogTranslation[]
  projectTranslations ProjectTranslation[]
}

model User {
  id                  String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email               String               @unique
  emailVerified       DateTime?            @db.Timestamptz(3)
  hashedPassword      String?
  name                String
  phone               String?
  address             String?
  addressData         Json?
  website             String?
  image               String?
  bio                 String?
  role                Role                 @default(USER)
  accessRoleId        String               @db.Uuid
  accessRole          AccessRole           @relation(fields: [accessRoleId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?            @db.Timestamptz(3)
  accounts            Account[]
  blogs               Blog[]
  comments            Comment[]
  commentReactions    CommentReaction[]
  passwordResetTokens PasswordResetToken[]
  aiUsageLogs         AiUsageLog[]

  @@index([email], name: "email")
}

model Account {
  id                String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([token])
}

model Blog {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  image        String
  shortImage   String
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?          @db.Timestamptz(3)
  comments     Comment[]
  tags         Tag[]
  categories   Category[]
  translations BlogTranslation[]
  author       User?              @relation(fields: [authorId], references: [id], onDelete: SetDefault, onUpdate: Cascade)
  authorId     String?            @db.Uuid

  @@index([authorId], name: "authorId")
}

model BlogTranslation {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  blogId     String   @db.Uuid
  blog       Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  languageId String   @db.Uuid
  language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict)
  title      String
  content    String
  summary    String
  published  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([blogId, languageId])
  @@index([languageId, published])
}

model Category {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  blogs     Blog[]
}

model Comment {
  id        String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content   String
  status    Status            @default(PENDING)
  isReply   Boolean           @default(false)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?         @db.Timestamptz(3)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId    String?           @db.Uuid
  blog      Blog?             @relation(fields: [blogId], references: [id])
  blogId    String?           @db.Uuid
  replies   Comment[]         @relation("ReplyToComment")
  parent    Comment?          @relation("ReplyToComment", fields: [commentId], references: [id])
  commentId String?           @db.Uuid
  reactions CommentReaction[]
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  LIKE
  DISLIKE
}

model CommentReaction {
  id        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type      ReactionType
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([commentId, userId])
  @@index([commentId])
}

model Tag {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  blogs     Blog[]
}

model Project {
  id           String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  url          String?
  image        String?
  gallery      String[]             @default([])
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?            @db.Timestamptz(3)
  translations ProjectTranslation[]

  @@index([sortOrder])
}

model ProjectTranslation {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageId  String   @db.Uuid
  language    Language @relation(fields: [languageId], references: [id], onDelete: Restrict)
  title       String
  description String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, languageId])
  @@index([languageId, published])
}

/// Site geneli tek özgeçmiş (PDF) kaydı.
model SiteResume {
  id        String   @id @default("default")
  url       String
  fileName  String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum AiProvider {
  gemini
  groq
  ollama
}

enum AiUsageAction {
  translate
  expand
  generate
  improve
  test
}

enum SiteSnippetType {
  TIP
  FOOTER_MOTTO
}

/// Site geneli döner metinler (ipuçları, footer şakaları).
model SiteSnippet {
  id        String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type      SiteSnippetType
  locale    String
  content   String
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([locale, type, content])
  @@index([type, locale, sortOrder])
  @@index([type, locale, isActive])
}

/// Yapay zeka API çağrı kayıtları (istatistik ve denetim).
model AiUsageLog {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String?        @db.Uuid
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        AiUsageAction
  context       String
  provider      AiProvider
  model         String
  promptChars   Int            @default(0)
  responseChars Int            @default(0)
  durationMs    Int            @default(0)
  success       Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([context, createdAt])
}

/// Site geneli AI içerik/çeviri ayarları (süper admin).
model SiteAiSettings {
  id                  String     @id @default("default")
  enabled             Boolean    @default(false)
  provider            AiProvider @default(gemini)
  geminiApiKey        String?
  groqApiKey          String?
  geminiModel         String     @default("gemini-2.0-flash")
  groqModel           String     @default("llama-3.3-70b-versatile")
  ollamaBaseUrl       String     @default("http://localhost:11434")
  ollamaModel         String     @default("llama3.2")
  autoTranslateOnSave Boolean    @default(true)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
}
