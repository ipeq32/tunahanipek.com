# Copy to .env and fill in real values (never commit .env)

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_SALT=your-nextauth-salt-here

POSTGRES_PRISMA_URL=postgresql://postgres:password@localhost:5432/postgres?schema=public
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@localhost:5432/postgres?schema=public

NEXT_PUBLIC_API_URL=http://localhost:3000

# UploadThing (görsel yükleme ve orphan dosya temizliği için gerekli)
UPLOADTHING_TOKEN=

# Şifre sıfırlama e-postası (üretim)
RESEND_API_KEY=
EMAIL_FROM=Blog <noreply@yourdomain.com>

# Geliştirmede RESEND yoksa sıfırlama linki loglarda görünür

# Prod canonical URL (robots, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Açık kayıt (false = kayıt kapalı)
ALLOW_PUBLIC_REGISTRATION=true
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=true

# OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google: buton/One Tap credential akışı (JS origin gerekir).
# GitHub/LinkedIn: OAuth redirect (callback URI gerekir).
# One Tap=true → sayfa açılınca otomatik popup da gösterilir.
NEXT_PUBLIC_GOOGLE_ONE_TAP_ENABLED=false
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

PORT=3000
VERCEL_URL=
