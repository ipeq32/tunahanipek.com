# PostgreSQL (database servisi)
POSTGRES_PASSWORD=tuna213
POSTGRES_PORT=5432

# Blog
BLOG_PORT=3000
NEXTAUTH_URL=http://localhost:3000
# ZORUNLU: prod compose bos birakilirsa baslatmayi durdurur (fail-fast).
# Uretim degeri uretin: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_SALT=change-me-in-production
# NEXT_PUBLIC_* degerleri build aninda client bundle'a gomulur.
# Prod'da gercek public URL verin (ornek: https://blog.tunahanipek.com).
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VERCEL_URL=blog.tunahanipek.com
UPLOADTHING_TOKEN=eyJhcGiXX0=
RESEND_API_KEY=
EMAIL_FROM=Blog <noreply@yourdomain.com>
# Kayit kontrolu: server (ALLOW_*) + UI gizleme (NEXT_PUBLIC_ALLOW_*)
ALLOW_PUBLIC_REGISTRATION=true
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=true

# OAuth
# Google buton + One Tap: credential akışı → JS origin yeterli (redirect URI gerekmez)
# GitHub/LinkedIn: OAuth redirect → callback URI gerekir
# Google Cloud Console -> OAuth 2.0 Client ID
# JS origins: http://localhost:3000
# Redirect URIs (GitHub/LinkedIn için): http://localhost:3000/api/auth/callback/{provider}
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ONE_TAP_ENABLED=false

# GitHub -> Settings -> Developer settings -> OAuth Apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# LinkedIn Developer Portal -> Sign In with LinkedIn (OpenID Connect)
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Home
HOME_PORT=3001
# Blog public API tabanı (ozgecmis fetch). Prod: https://blog.tunahanipek.com
BLOG_API_URL=http://localhost:3000
