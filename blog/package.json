{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "generate-local": "npx prisma generate && npx prisma db push && yarn seed",
    "generate-prod": "npx prisma generate && npx prisma db push",
    "seed": "npx prisma db seed",
    "db:reset": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/reset.ts",
    "db:reset:seed": "yarn db:reset --force && yarn seed"
  },
