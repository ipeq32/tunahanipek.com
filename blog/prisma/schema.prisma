generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp")]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Language {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String   @unique
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  blogTranslations    BlogTranslation[]
  projectTranslations ProjectTranslation[]
}

model User {
  id                  String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email               String               @unique
  hashedPassword      String
  name                String
  phone               String
  address             String
  addressData         Json?
  website             String?
  image               String?
  bio                 String?
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?            @db.Timestamptz(3)
  blogs               Blog[]
  comments            Comment[]
  commentReactions    CommentReaction[]
  passwordResetTokens PasswordResetToken[]

  @@index([email], name: "email")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([token])
}

model Blog {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  image        String
  shortImage   String
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?          @db.Timestamptz(3)
  comments     Comment[]
  tags         Tag[]
  categories   Category[]
  translations BlogTranslation[]
  author       User?              @relation(fields: [authorId], references: [id], onDelete: SetDefault, onUpdate: Cascade)
  authorId     String?            @db.Uuid

  @@index([authorId], name: "authorId")
}

model BlogTranslation {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  blogId     String   @db.Uuid
  blog       Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  languageId String   @db.Uuid
  language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict)
  title      String
  content    String
  summary    String
  published  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([blogId, languageId])
  @@index([languageId, published])
}

model Category {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  blogs     Blog[]
}

model Comment {
  id        String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content   String
  status    Status            @default(PENDING)
  isReply   Boolean           @default(false)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?         @db.Timestamptz(3)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId    String?           @db.Uuid
  blog      Blog?             @relation(fields: [blogId], references: [id])
  blogId    String?           @db.Uuid
  replies   Comment[]         @relation("ReplyToComment")
  parent    Comment?          @relation("ReplyToComment", fields: [commentId], references: [id])
  commentId String?           @db.Uuid
  reactions CommentReaction[]
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  LIKE
  DISLIKE
}

model CommentReaction {
  id        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type      ReactionType
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([commentId, userId])
  @@index([commentId])
}

model Tag {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  blogs     Blog[]
}

model Project {
  id           String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  url          String?
  image        String?
  gallery      String[]             @default([])
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?            @db.Timestamptz(3)
  translations ProjectTranslation[]

  @@index([sortOrder])
}

model ProjectTranslation {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageId  String   @db.Uuid
  language    Language @relation(fields: [languageId], references: [id], onDelete: Restrict)
  title       String
  description String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, languageId])
  @@index([languageId, published])
}

/// Site geneli tek özgeçmiş (PDF) kaydı.
model SiteResume {
  id        String   @id @default("default")
  url       String
  fileName  String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum AiProvider {
  gemini
  groq
  ollama
}

/// Site geneli AI içerik/çeviri ayarları (süper admin).
model SiteAiSettings {
  id                  String     @id @default("default")
  enabled             Boolean    @default(false)
  provider            AiProvider @default(gemini)
  geminiApiKey        String?
  groqApiKey          String?
  geminiModel         String     @default("gemini-2.0-flash")
  groqModel           String     @default("llama-3.3-70b-versatile")
  ollamaBaseUrl       String     @default("http://localhost:11434")
  ollamaModel         String     @default("llama3.2")
  autoTranslateOnSave Boolean    @default(true)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
}
